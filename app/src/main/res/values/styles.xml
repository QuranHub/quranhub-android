<resources>

    <!-- Material 1.14 does not ship a Material3 DarkActionBar theme. -->
    <style name="Theme.Material3.Light.DarkActionBar" parent="Theme.Material3.Light">
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
        <item name="actionBarWidgetTheme">@null</item>
    </style>

    <!-- Always light. Do not switch this parent to DayNight. -->
    <style name="AppTheme" parent="Theme.Material3.Light.DarkActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/white_color</item>
        <item name="colorPrimaryContainer">@color/color_primary</item>
        <item name="colorOnPrimaryContainer">@color/white_color</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorSecondary">@color/color_accent</item>
        <item name="colorOnSecondary">@color/white_color</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="colorControlActivated">@color/color_accent</item>
        <item name="colorControlHighlight">@color/color_control_highlight</item>
        <item name="android:colorBackground">@color/white_color</item>
        <item name="colorSurface">@color/white_color</item>
        <item name="colorOnSurface">@color/black_color</item>
        <item name="android:statusBarColor">@color/color_primary_dark</item>

        <item name="android:fontFamily">@font/main_font</item>
        <item name="fontFamily">@font/main_font</item>

        <!-- Material3 would restyle these; keep the pre-migration widgets. -->
        <item name="android:buttonStyle">@style/Widget.AppCompat.Button</item>
        <item name="borderlessButtonStyle">@style/Widget.AppCompat.Button.Borderless</item>
        <item name="tabStyle">@style/Widget.MaterialComponents.TabLayout</item>

        <item name="materialDrawerStyle">@style/Widget.QuranHub.MaterialDrawer</item>
        <item name="materialDrawerHeaderStyle">@style/Widget.MaterialDrawerHeaderStyle</item>
    </style>

    <style name="Widget.QuranHub.MaterialDrawer" parent="Widget.MaterialDrawerStyle">
        <item name="materialDrawerBackground">@color/white_color</item>
        <!-- v6 light selected row: 12% #2196F3 -->
        <item name="materialDrawerSelectedBackgroundColor">#1F2196F3</item>
        <item name="materialDrawerPrimaryText">@color/drawer_text_color</item>
        <item name="materialDrawerPrimaryIcon">@color/drawer_text_color</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="SplashTheme" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>

        <!-- Transparent status bar -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <!-- Material3 AppBarLayout paints ?colorSurface. These bars used to be colorPrimary. -->
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorSurface">@color/color_primary</item>
        <item name="colorOnSurface">@color/white_color</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="CustomTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/text_12</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="StandardListItemTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textSize">@dimen/text_12</item>
    </style>

    <style name="ActionBarTitleTextAppearance">
        <item name="android:textSize">20sp</item>
    </style>

</resources>
